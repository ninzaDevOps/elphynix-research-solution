# Copy this file to .env for local development. Replace every CHANGE_ME value.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=elphynix_research
DB_USER=elphynix_app
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

FLASK_SECRET_KEY=CHANGE_ME_LONG_RANDOM_FLASK_SECRET
JWT_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM_JWT_SECRET
JWT_EXP_HOURS=8
COOKIE_SECURE=false
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
